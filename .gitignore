# M1 验证参考样例是受控证据，需要入库
!envs/batchframework/validation_fixtures/*.json
# E5 迁移 manifest 是可追踪证据，需要入库
!envs/batchframework/migration_manifests/*.json
# Reclip BC 冻结目标是受控实验契约，需要入库
!mocap/humanoid21/clip/data/reclip_bc/cmu_strike_target/target_clip.npz
!mocap/humanoid21/clip/data/reclip_bc/cmu_strike_target/experiment_spec.json
!mocap/humanoid21/clip/data/reclip_bc/cmu_strike_target/target_video.mp4
# GMR ik 映射配置是核心交付物，需要入库
!mocap/humanoid21/gmr/smplx_to_humanoid21.json
